{
  "name": "ENVS225 RStudio",

  // Rocker's Codespaces image: R, RStudio Server and the tidyverse preinstalled.
  // Extra packages used in the labs are added by setup.sh.
  "image": "ghcr.io/rocker-org/devcontainer/tidyverse:4",

  "features": {
    // Configures RStudio in single-user mode (no login page) and sets its
    // initial working directory to the repo folder.
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server:0": {}
  },

  "remoteUser": "rstudio",

  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Runs every time the codespace is opened/resumed, so RStudio is always up.
  "postAttachCommand": {
    "rstudio-start": "rserver"
  },

  "forwardPorts": [8787],

  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "quarto.quarto"
      ],
      // Students work in RStudio; keep the VS Code tab as quiet as possible.
      "settings": {
        "workbench.startupEditor": "none",
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        "workbench.tips.enabled": false
      }
    }
  }
}
