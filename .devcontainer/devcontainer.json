{
  "name": "GDSL Statistics RStudio",

  "image": "rocker/rstudio:4.4.1",

  "forwardPorts": [
    8787
  ],

  "portsAttributes": {
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "quarto.quarto",
        "ms-toolsai.jupyter"
      ]
    }
  }
}